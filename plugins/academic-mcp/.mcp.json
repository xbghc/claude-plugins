{
  "mcpServers": {
    "zotero": {
      "command": "npx",
      "args": [
        "-y",
        "@xbghc/zotero-mcp"
      ],
      "env": {
        "ZOTERO_API_KEY": "${ZOTERO_API_KEY:-}",
        "ZOTERO_USER_ID": "${ZOTERO_USER_ID:-}"
      }
    },
    "semanticscholar": {
      "command": "npx",
      "args": [
        "-y",
        "@xbghc/semanticscholar-mcp"
      ],
      "env": {
        "SEMANTIC_SCHOLAR_API_KEY": "${SEMANTIC_SCHOLAR_API_KEY:-}"
      }
    }
  }
}
